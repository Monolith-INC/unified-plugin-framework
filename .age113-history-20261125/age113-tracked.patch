     : block.replace(/^---(\r?\n)/u, `---$1name: ${targetName}$1`);
   return `${updated}${content.slice(block.length)}`;
 };
+
+const CODEX_USER_INPUT_KEY = /^\s*default_mode_request_user_input\s*=/mu;
+const FEATURES_HEADER = /^(\s*\[features\]\s*(?:#[^\n]*)?\r?\n?)/mu;
+
+/** Whether `.codex/config.toml` already sets `default_mode_request_user_input` (either true or an explicit user choice). */
+export const hasCodexUserInputFeature = (existing: string | null): boolean =>
+  existing !== null && CODEX_USER_INPUT_KEY.test(existing);
+
+/**
+ * Purely enable `default_mode_request_user_input = true` under `[features]` in `.codex/config.toml` while preserving
+ * all unrelated settings and respecting any explicit user value already configured.
+ */
+export const mergeCodexUserInputFeature = (existing: string | null): string => {
+  if (existing === null || existing.trim().length === 0) {
+    return "[features]\ndefault_mode_request_user_input = true\n";
+  }
+  if (hasCodexUserInputFeature(existing)) return existing;
+  if (FEATURES_HEADER.test(existing)) {
+    return existing.replace(FEATURES_HEADER, (header) =>
+      `${header.endsWith("\n") ? header : `${header}\n`}default_mode_request_user_input = true\n`);
+  }
+  return `${existing.endsWith("\n") ? existing : `${existing}\n`}\n[features]\ndefault_mode_request_user_input = true\n`;
+};
