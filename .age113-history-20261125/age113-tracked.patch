+const ensureCodexConfig = async (context: HostContext): Promise<Result<string>> => {
+  const path = join(context.project, CODEX_CONFIG_FILE);
+  if (!await safePath(context.project, path)) {
+    return fail("symlink-escape", "The Codex configuration path escapes the project or follows a symbolic link.",
+      "Preserve the linked path and choose an unlinked location inside the project.");
+  }
+  const existing = await readText(path);
+  if (!existing.ok) return existing;
+  const next = mergeCodexUserInputFeature(existing.value);
+  if (existing.value === next) return ok(path);
+  const dir = await directory(context.project, dirname(path));
+  if (!dir.ok) return dir;
+  return writeFile(path, next, "utf8")
+    .then(() => ok(path))
+    .catch(() => fail("tooling-storage", "Could not write .codex/config.toml.", "Check file permissions and rerun setup."));
+};
