{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "unified-plugin-framework",
  "version": "0.1.0",
  "description": "Project companion workflows backed by onboarded plugins through workflow adapters.",
  "author": {
    "name": "Monolith-INC",
    "url": "https://github.com/Monolith-INC"
  },
  "license": "Apache-2.0",
  "extensions": {
    "io.github.monolith-inc.upf": {
      "onboardedPlugins": [
        {
          "name": "agent-continuity",
          "version": "0.13.0",
          "source": "github:Monolith-INC/agent-continuity",
          "adapter": "continuity"
        },
        {
          "name": "agile-backlog-toolkit",
          "version": "0.12.1",
          "source": "github:theocarranza/agile-backlog-toolkit",
          "adapter": "project-tracking"
        },
        {
          "name": "monolithic-code-review-toolkit",
          "version": "^0.6.0",
          "source": "github:Monolith-INC/monolithic-code-review-toolkit/plugins/monolithic-code-review-toolkit",
          "adapter": "code-review"
        },
        {
          "name": "superpowers",
          "version": "^7.0.0",
          "source": "github:obra/superpowers",
          "adapter": [
            "discovery",
            "implementation"
          ]
        },
        {
          "name": "bmad-method",
          "version": "^6.12.0",
          "source": "github:bmad-code-org/BMAD-METHOD#1cbcfa272fe65787c06a1fa164a901f46117cca7",
          "adapter": "discovery"
        },
        {
          "name": "monolithic-agent-knowledge-store",
          "version": "^0.4.1",
          "source": "github:Monolith-INC/monolithic-agent-knowledge-store",
          "adapter": "knowledge"
        }
      ]
    }
  }
}
