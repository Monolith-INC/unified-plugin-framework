{
  "name": "agent-plugins-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Reference implementation and CLI for the Agent Plugins v1.0.0 portable architecture.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:core": "pnpm --filter @agent-plugins/core build",
    "build:cli": "pnpm --filter @agent-plugins/cli build",
    "build:testing": "pnpm --filter @agent-plugins/testing build",
    "payloads:build": "pnpm -r --workspace-concurrency=1 --if-present run payload:build",
    "payloads:verify": "pnpm -r --workspace-concurrency=1 --if-present run payload:verify",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "test": "pnpm -r --no-bail --filter \"./packages/*\" test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.14.0"
}
